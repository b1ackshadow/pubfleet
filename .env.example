# Copy to .env and change what you need. .env is git-ignored.
# These are local development values. Do not put a real secret in any file.

# --- Postgres, read by docker-compose.yml ---
POSTGRES_DB=pubfleet
POSTGRES_USER=pubfleet
POSTGRES_PASSWORD=pubfleet
POSTGRES_PORT=5432

# --- Kafka, read by docker-compose.yml ---
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=pubfleet-local-cluster

# --- The applications, read by Spring Boot ---
PUBFLEET_DB_URL=jdbc:postgresql://localhost:5432/pubfleet
PUBFLEET_DB_USER=pubfleet
PUBFLEET_DB_PASSWORD=pubfleet
PUBFLEET_KAFKA_BOOTSTRAP=localhost:9092

# --- Control plane ---
PUBFLEET_CONTROL_PLANE_PORT=8081

# --- Worker ---
# Give each worker its own id when you run more than one.
PUBFLEET_WORKER_ID=worker-1
PUBFLEET_WORKER_BATCH_SIZE=5
PUBFLEET_WORKER_POLL_DELAY=500ms
PUBFLEET_WORKER_WORK_DELAY=200ms
